---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'UK ERP and CRM case studies',
  description: 'Case studies showing how UK businesses improve efficiency, billing, and inventory with dig1tal.',
  url: 'https://www.dig1tal.io/case-studies',
};

const studies = [
  {
    company: 'Midlands Precision Components',
    location: 'Birmingham',
    headline: '40% efficiency gain across sales and production handovers',
    challenge: 'The manufacturer relied on spreadsheets and email to manage quotes, orders, and production planning, which created delays and duplicate data entry.',
    solution: 'dig1tal connected CRM, quoting, and ERP workflows so the team could move from lead to order with cleaner information and shared visibility.',
    results: ['40% improvement in process efficiency', '25% faster quote turnaround', 'Single view of pipeline, jobs, and customer demand'],
  },
  {
    company: 'Crown Advisory Partners',
    location: 'London',
    headline: 'Streamlined billing and project delivery for a growing services firm',
    challenge: 'Project teams tracked delivery separately from sales, making utilisation reporting and billing preparation difficult.',
    solution: 'We implemented CRM-to-project workflows, centralised task tracking, and finance-ready billing data for account and delivery teams.',
    results: ['Billing cycle reduced by 12 days', 'Improved utilisation reporting', 'Stronger visibility across renewals and active projects'],
  },
  {
    company: 'NorthGate Distribution',
    location: 'Manchester',
    headline: 'Inventory optimisation with clearer demand and account data',
    challenge: 'The business struggled to align account demand, inventory levels, and fulfilment planning across multiple channels.',
    solution: 'dig1tal unified CRM, stock-related workflows, and reporting dashboards so commercial and operations teams could plan together.',
    results: ['18% reduction in excess stock', 'Improved service levels on key accounts', 'Better regional demand planning and sales forecasting'],
  },
];
---

<BaseLayout
  title="UK ERP & CRM Case Studies"
  description="Read UK case studies from manufacturing, professional services, and distribution firms using dig1tal to improve efficiency, billing, and inventory control."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">Case Studies</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        UK ERP &amp; CRM Case Studies with Measurable Results
      </h1>
      <p class="section-subheading">
        See how UK businesses use dig1tal to improve operational flow, billing accuracy, inventory control, and customer visibility.
      </p>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {studies.map((study) => (
          <article class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">{study.location}</p>
                <h2 class="mt-2 text-2xl font-semibold text-gray-900">{study.company}</h2>
              </div>
              <p class="text-lg font-semibold text-gray-900">{study.headline}</p>
            </div>
            <div class="mt-8 grid gap-6 lg:grid-cols-3">
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Challenge</h3>
                <p class="mt-3 leading-7 text-gray-600">{study.challenge}</p>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Solution</h3>
                <p class="mt-3 leading-7 text-gray-600">{study.solution}</p>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900">Results</h3>
                <ul class="mt-3 space-y-3 text-gray-600">
                  {study.results.map((result) => (
                    <li class="flex gap-3"><span class="text-primary-600">✓</span><span>{result}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Let’s build your next case study</h2>
      <p class="mt-4 text-lg text-primary-100">
        Book a demo to explore how dig1tal can improve your reporting, process control, and customer operations.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Book a demo</a>
      </div>
    </div>
  </section>
</BaseLayout>

