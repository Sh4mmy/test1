---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'ERP and CRM implementation',
  provider: {
    '@type': 'Organization',
    name: 'dig1tal',
  },
  areaServed: 'GB',
  description: 'ERP and CRM solutions for UK businesses integrating sales, finance, inventory, HR, and compliance workflows.',
  url: 'https://www.dig1tal.io/erp-solutions',
};

const pillars = [
  {
    icon: '🔗',
    title: 'CRM connected to the wider ERP stack',
    description: 'Link commercial activity with finance, stock, procurement, service, and HR so every department works from the same data foundation.',
  },
  {
    icon: '⚙️',
    title: 'Built around ERPNext and Frappe',
    description: 'Use the flexibility of the ERPNext/Frappe ecosystem to tailor workflows, permissions, forms, and dashboards to your operating model.',
  },
  {
    icon: '💷',
    title: 'UK compliance and finance readiness',
    description: 'Support Making Tax Digital processes, VAT reporting, and integrations with Xero and Sage for smoother accounting operations.',
  },
];

const processSteps = [
  'Lead captured from web, phone, referral, or outbound campaign',
  'Quote created with products, pricing, and approvals aligned to your process',
  'Sales order issued and handed into fulfilment or delivery operations',
  'Invoice raised with finance-ready data for accounting and reporting',
];

const safeguards = [
  'Role-based access controls and audit trails',
  'GDPR-conscious data handling processes for UK customer records',
  'Secure integrations and documented change management',
  'Clear ownership across CRM, ERP, and finance workflows',
];
---

<BaseLayout
  title="ERP Solutions for UK Businesses"
  description="Discover how dig1tal connects CRM with finance, inventory, HR, and ERPNext workflows for UK businesses needing end-to-end operational visibility."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">UK ERP Solutions</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          ERP Solutions That Connect CRM, Finance, Operations, and Compliance
        </h1>
        <p class="section-subheading">
          dig1tal helps UK businesses connect front-office sales with back-office delivery, finance, and reporting using a practical ERP-first approach.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-3">
        {pillars.map((pillar) => (
          <article class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
            <div class="text-3xl">{pillar.icon}</div>
            <h2 class="mt-4 text-2xl font-semibold text-gray-900">{pillar.title}</h2>
            <p class="mt-3 leading-7 text-gray-600">{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div>
          <h2 class="section-heading">Lead → Quote → Order → Invoice, managed as one business process</h2>
          <p class="section-subheading">
            Create a consistent handover from sales to operations to accounts, with less rekeying, fewer errors, and better visibility for leadership teams.
          </p>
        </div>
        <div class="space-y-4">
          {processSteps.map((step, index) => (
            <div class="flex gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-gray-100">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-600 font-semibold text-white">{index + 1}</div>
              <p class="pt-1 text-gray-600">{step}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <article class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-semibold text-gray-900">📊 Making Tax Digital and UK accounting integrations</h2>
        <p class="mt-4 leading-7 text-gray-600">
          Support MTD-ready processes with cleaner transaction flow, reliable master data, and integrations for Xero and Sage. Bring sales orders, invoices, and finance reporting closer together without sacrificing flexibility.
        </p>
      </article>
      <article class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-semibold text-gray-900">🛡️ Data security and GDPR by design</h2>
        <p class="mt-4 leading-7 text-gray-600">
          Protect customer and commercial data with permission controls, auditability, and governance processes suited to UK compliance expectations.
        </p>
        <ul class="mt-6 space-y-3 text-gray-600">
          {safeguards.map((item) => (
            <li class="flex gap-3"><span class="text-primary-600">✓</span><span>{item}</span></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Ready to connect CRM and ERP in one UK-ready platform?</h2>
      <p class="mt-4 text-lg text-primary-100">
        Book a consultation and we will map your finance, inventory, HR, and sales processes into a practical implementation plan.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Speak to the team</a>
      </div>
    </div>
  </section>
</BaseLayout>

