---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'dig1tal integrations',
  description: 'Accounting, communications, productivity, payments, and e-commerce integrations for UK businesses.',
  url: 'https://www.dig1tal.io/integrations',
};

const categories = [
  {
    title: 'Accounting',
    items: ['Xero', 'Sage', 'QuickBooks'],
  },
  {
    title: 'Communication',
    items: ['WhatsApp', 'Twilio', 'Email'],
  },
  {
    title: 'Productivity',
    items: ['Google Workspace', 'Microsoft 365'],
  },
  {
    title: 'Payment',
    items: ['Stripe', 'GoCardless'],
  },
  {
    title: 'E-commerce',
    items: ['Shopify', 'WooCommerce'],
  },
];
---

<BaseLayout
  title="ERP & CRM Integrations for UK Businesses"
  description="Explore dig1tal integrations for UK businesses, including Xero, Sage, QuickBooks, WhatsApp, Stripe, Shopify, Microsoft 365, and more."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">Integrations</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        UK ERP &amp; CRM Integrations That Fit Your Existing Stack
      </h1>
      <p class="section-subheading">
        Connect dig1tal with the accounting, communications, productivity, payment, and e-commerce tools your teams already rely on.
      </p>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-12">
        {categories.map((category) => (
          <section>
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-2xl font-semibold text-gray-900">{category.title}</h2>
              <div class="hidden h-px flex-1 bg-gray-200 sm:block"></div>
            </div>
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
              {category.items.map((item) => (
                <article class="flex min-h-32 flex-col items-center justify-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-sm">
                  <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary-50 text-xl font-bold text-primary-700">
                    {item.slice(0, 2).toUpperCase()}
                  </div>
                  <h3 class="mt-4 text-lg font-semibold text-gray-900">{item}</h3>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="mt-16 rounded-2xl bg-gray-50 p-8 text-center ring-1 ring-gray-100">
        <h2 class="text-2xl font-semibold text-gray-900">Don’t see your tool?</h2>
        <p class="mt-3 text-gray-600">
          We offer custom API integrations for specialist ERP, CRM, warehouse, service, and reporting requirements.
        </p>
        <a href="/contact" class="btn-secondary mt-6">Discuss a custom integration</a>
      </div>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Plan your integration roadmap with dig1tal</h2>
      <p class="mt-4 text-lg text-primary-100">
        Talk through your current systems and we will recommend the most effective integration approach for your UK business.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Book a consultation</a>
      </div>
    </div>
  </section>
</BaseLayout>

