---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'dig1tal CRM & ERP Platform',
  description: 'A CRM and ERP platform for UK businesses that unifies sales, service, reporting, communications, and automation.',
  brand: {
    '@type': 'Brand',
    name: 'dig1tal',
  },
  category: 'CRM Software',
  audience: {
    '@type': 'BusinessAudience',
    geographicArea: {
      '@type': 'Country',
      name: 'United Kingdom',
    },
  },
  url: 'https://www.dig1tal.io/features',
};

const features = [
  {
    icon: '🎯',
    title: 'Sales Pipeline & Lead Management',
    description: 'Keep every UK opportunity moving with configurable pipeline stages, lead scoring, follow-up reminders, and quote-ready deal views.',
  },
  {
    icon: '👥',
    title: 'Contact & Organisation Management',
    description: 'Store decision-makers, buying groups, sites, and contract history in one place so your team always has the full customer picture.',
  },
  {
    icon: '✅',
    title: 'Task & Activity Management',
    description: 'Assign tasks, log calls, plan visits, and keep account managers accountable with shared activity timelines and SLA tracking.',
  },
  {
    icon: '📞',
    title: 'Email, WhatsApp & VoIP Communications',
    description: 'Run customer conversations across email, WhatsApp, and voice from one workspace with full interaction history for every account.',
  },
  {
    icon: '🗂️',
    title: 'Kanban Boards & Workflow Automation',
    description: 'Automate routine admin, trigger alerts, and manage approvals with visual boards tailored to your sales, service, or onboarding process.',
  },
  {
    icon: '📈',
    title: 'Reporting & Analytics',
    description: 'Track pipeline value, team performance, conversion rates, and revenue trends with dashboards built for leadership teams and department heads.',
  },
  {
    icon: '📱',
    title: 'Mobile App (PWA)',
    description: 'Give field sales, service engineers, and directors secure mobile access from any device with an installable progressive web app.',
  },
  {
    icon: '🔌',
    title: 'API & Custom Fields',
    description: 'Adapt dig1tal to your processes with custom fields, role-based layouts, and API-first integrations across ERP, finance, and support tools.',
  },
];
---

<BaseLayout
  title="CRM Features for UK ERP Teams"
  description="Explore dig1tal CRM features for UK businesses, including pipeline management, workflow automation, communications, analytics, and API integrations."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">CRM Features for UK Businesses</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
          ERP-Ready CRM Features That Help UK Teams Sell, Serve, and Scale
        </h1>
        <p class="section-subheading">
          dig1tal combines sales, communications, workflow, and reporting in one open platform built for the realities of UK ERP and CRM operations.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="section-heading">Feature set built for commercial and operational teams</h2>
        <p class="section-subheading">
          Whether you are replacing spreadsheets or modernising an existing stack, dig1tal covers the workflows UK sales and service teams rely on every day.
        </p>
      </div>
      <div class="mt-16 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {features.map((feature) => (
          <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-2xl">
              <span>{feature.icon}</span>
            </div>
            <h2 class="mt-5 text-xl font-semibold text-gray-900">{feature.title}</h2>
            <p class="mt-3 text-sm leading-7 text-gray-600 sm:text-base">{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <h2 class="section-heading">A single source of truth from lead capture to customer retention</h2>
          <p class="section-subheading">
            Replace disconnected tools with one platform that supports pipeline reviews, account management, account-based selling, and operational handovers.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-100">
          <ul class="space-y-4 text-sm text-gray-600 sm:text-base">
            <li class="flex gap-3"><span class="text-primary-600">•</span><span>Track every lead source, campaign, and conversion path across your UK sales funnel.</span></li>
            <li class="flex gap-3"><span class="text-primary-600">•</span><span>Automate follow-ups, task creation, and notifications to reduce manual admin.</span></li>
            <li class="flex gap-3"><span class="text-primary-600">•</span><span>Connect CRM records to finance, support, fulfilment, and ERP workflows as your business grows.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">See dig1tal features in a live UK ERP & CRM demo</h2>
      <p class="mt-4 text-lg text-primary-100">
        Talk to our team about your pipeline, reporting, and integration goals and we will map the right setup for your business.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Book a Demo</a>
        <a href="/pricing" class="btn-secondary border-white text-white hover:bg-primary-600">View Pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>

