---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Are prices charged in GBP?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All dig1tal pricing is quoted in GBP for UK businesses.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you offer annual discounts?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Annual plans receive a discount compared with monthly billing, subject to final scope and user volumes.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can you help with ERP and accounting integrations?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Professional and Enterprise plans include access to integrations and implementation support for ERP, accounting, and communication tools.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a minimum contract term?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Starter and Professional can begin monthly, while Enterprise agreements are scoped around support, delivery, and custom development needs.',
      },
    },
  ],
};

const tiers = [
  {
    name: 'Starter',
    price: '£29',
    period: 'user / month',
    description: 'For smaller UK teams adopting a structured CRM for the first time.',
    features: ['Basic CRM and contact management', 'Sales pipeline visibility', 'Task tracking and activity history', 'Up to 5 users'],
  },
  {
    name: 'Professional',
    price: '£59',
    period: 'user / month',
    description: 'For growing businesses needing full CRM capability and integrations.',
    features: ['Full CRM suite with automation', 'ERP, finance, and communications integrations', 'Reporting dashboards and custom fields', 'Unlimited users'],
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: 'pricing',
    description: 'For complex UK organisations requiring dedicated support and custom development.',
    features: ['Dedicated support and solution design', 'Custom development and advanced workflows', 'Governance, security, and rollout planning', 'Multi-team implementation support'],
  },
];

const faqs = [
  {
    question: 'Are prices charged in GBP?',
    answer: 'Yes. All pricing is quoted in GBP and designed for UK businesses buying CRM and ERP software locally.',
  },
  {
    question: 'Do you offer an annual discount?',
    answer: 'Yes. Annual billing receives a discount versus monthly billing, and we can tailor commercial terms for larger user volumes.',
  },
  {
    question: 'What is included in onboarding?',
    answer: 'We can support discovery, configuration, data migration, user training, and integration planning depending on the package you choose.',
  },
  {
    question: 'Can Enterprise include bespoke features?',
    answer: 'Yes. Enterprise plans can include custom development, additional integrations, and dedicated account support.',
  },
];
---

<BaseLayout
  title="CRM & ERP Pricing in GBP"
  description="View dig1tal pricing for UK businesses with Starter, Professional, and Enterprise ERP and CRM plans in GBP, plus FAQ and annual billing information."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">UK Pricing</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        ERP &amp; CRM Pricing for UK Businesses in GBP
      </h1>
      <p class="section-subheading">
        Simple commercial options for growing teams, with annual discounts available for businesses ready to roll out dig1tal across the organisation.
      </p>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-3">
        {tiers.map((tier) => (
          <article class:list={[
            'rounded-2xl border bg-white p-8 shadow-sm',
            tier.featured ? 'border-primary-600 ring-2 ring-primary-100' : 'border-gray-100',
          ]}>
            {tier.featured && <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">Most Popular</p>}
            <h2 class="mt-3 text-2xl font-semibold text-gray-900">{tier.name}</h2>
            <p class="mt-4 text-4xl font-extrabold text-gray-900">{tier.price}</p>
            <p class="mt-1 text-sm text-gray-500">{tier.period}</p>
            <p class="mt-4 leading-7 text-gray-600">{tier.description}</p>
            <ul class="mt-6 space-y-3 text-gray-600">
              {tier.features.map((feature) => (
                <li class="flex gap-3"><span class="text-primary-600">✓</span><span>{feature}</span></li>
              ))}
            </ul>
            <a href="/contact" class="btn-primary mt-8 w-full text-center">Talk to sales</a>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-gray-500">
        Annual billing discounts available. Implementation, migration, and custom integration services are scoped separately where required.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="section-heading">Frequently asked questions</h2>
        <p class="section-subheading">Common pricing questions from UK businesses reviewing CRM and ERP options.</p>
      </div>
      <div class="mt-12 space-y-4">
        {faqs.map((faq) => (
          <article class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100">
            <h3 class="text-lg font-semibold text-gray-900">{faq.question}</h3>
            <p class="mt-3 leading-7 text-gray-600">{faq.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Need a tailored ERP & CRM commercial proposal?</h2>
      <p class="mt-4 text-lg text-primary-100">
        Share your user numbers, integration needs, and rollout goals and we will recommend the right plan.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Request pricing advice</a>
      </div>
    </div>
  </section>
</BaseLayout>

