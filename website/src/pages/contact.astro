---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact dig1tal',
  description: 'Book a CRM and ERP demo with dig1tal for your UK business.',
  url: 'https://www.dig1tal.io/contact',
};
---

<BaseLayout
  title="Contact dig1tal for a UK ERP Demo"
  description="Book a CRM and ERP demo with dig1tal, contact our UK team, and share your requirements for sales, operations, finance, and integrations."
  jsonLd={jsonLd}
>
  <section class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary-600">Book a demo</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
        Contact Our UK ERP &amp; CRM Team
      </h1>
      <p class="section-subheading">
        Tell us about your business, your current systems, and the outcomes you want from a modern ERP and CRM platform.
      </p>
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-gray-900">Book your demo</h2>
          <form action="#" method="post" class="mt-8 grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
              <input id="name" name="name" type="text" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
              <input id="email" name="email" type="email" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-gray-700">Company</label>
              <input id="company" name="company" type="text" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700">Phone</label>
              <input id="phone" name="phone" type="tel" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200" />
            </div>
            <div class="sm:col-span-2">
              <label for="company-size" class="block text-sm font-medium text-gray-700">Company size</label>
              <select id="company-size" name="company-size" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200">
                <option>1-10 employees</option>
                <option>11-50 employees</option>
                <option>51-200 employees</option>
                <option>201-500 employees</option>
                <option>500+ employees</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
              <textarea id="message" name="message" rows="5" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200" placeholder="Tell us about your CRM, ERP, integration, or reporting goals."></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="btn-primary w-full sm:w-auto">Request a demo</button>
            </div>
          </form>
        </div>

        <div class="space-y-6">
          <article class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
            <h2 class="text-2xl font-semibold text-gray-900">Contact details</h2>
            <ul class="mt-6 space-y-4 text-gray-600">
              <li><span class="font-semibold text-gray-900">Office:</span> 123 Innovation House, London EC1A 1AA, United Kingdom</li>
              <li><span class="font-semibold text-gray-900">Phone:</span> <a href="tel:+442030000000" class="text-primary-600 hover:text-primary-700">+44 (0)20 3000 0000</a></li>
              <li><span class="font-semibold text-gray-900">Email:</span> <a href="mailto:hello@dig1tal.io" class="text-primary-600 hover:text-primary-700">hello@dig1tal.io</a></li>
              <li><span class="font-semibold text-gray-900">Hours:</span> Mon-Fri 9:00-17:30 GMT</li>
            </ul>
          </article>
          <article class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center shadow-sm">
            <h2 class="text-2xl font-semibold text-gray-900">Map placeholder</h2>
            <div class="mt-6 flex min-h-64 items-center justify-center rounded-2xl border border-dashed border-gray-300 bg-white px-6 text-gray-500">
              Interactive UK office map coming soon
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-primary-700 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Need to move quickly?</h2>
      <p class="mt-4 text-lg text-primary-100">
        Share your requirements today and our UK team will help you plan the right CRM and ERP next steps.
      </p>
      <div class="mt-8">
        <a href="/contact" class="btn-primary bg-white text-primary-700 hover:bg-primary-50">Book your demo</a>
      </div>
    </div>
  </section>
</BaseLayout>

