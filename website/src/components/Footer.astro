---
const footerLinks = {
  product: [
    { label: 'Features', href: '/features' },
    { label: 'ERP Solutions', href: '/erp-solutions' },
    { label: 'Integrations', href: '/integrations' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Case Studies', href: '/case-studies' },
  ],
  company: [
    { label: 'About Us', href: '/about' },
    { label: 'Blog', href: '/blog' },
    { label: 'Contact', href: '/contact' },
    { label: 'Careers', href: '/about#careers' },
  ],
  industries: [
    { label: 'Manufacturing', href: '/industries#manufacturing' },
    { label: 'Professional Services', href: '/industries#professional-services' },
    { label: 'Retail & Distribution', href: '/industries#retail' },
    { label: 'Construction', href: '/industries#construction' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy' },
    { label: 'Terms of Service', href: '/terms' },
    { label: 'GDPR Compliance', href: '/gdpr' },
    { label: 'Cookie Policy', href: '/cookies' },
  ],
};
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1">
        <a href="/" class="text-2xl font-bold text-primary-700">dig<span class="text-primary-500">1</span>tal</a>
        <p class="mt-3 text-sm text-gray-600">
          Modern ERP &amp; CRM solutions built for UK businesses. Streamline operations, boost sales, and grow with confidence.
        </p>
        <div class="mt-4 flex gap-3">
          <a href="https://linkedin.com/company/dig1tal" class="text-gray-400 hover:text-primary-600" aria-label="LinkedIn">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://twitter.com/dig1talio" class="text-gray-400 hover:text-primary-600" aria-label="Twitter">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a>
        </div>
      </div>

      <!-- Product Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Product</h3>
        <ul class="mt-4 space-y-2">
          {footerLinks.product.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 hover:text-primary-600">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Company</h3>
        <ul class="mt-4 space-y-2">
          {footerLinks.company.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 hover:text-primary-600">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Industries Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Industries</h3>
        <ul class="mt-4 space-y-2">
          {footerLinks.industries.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 hover:text-primary-600">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900">Legal</h3>
        <ul class="mt-4 space-y-2">
          {footerLinks.legal.map((link) => (
            <li><a href={link.href} class="text-sm text-gray-600 hover:text-primary-600">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-gray-200 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-gray-500">
          &copy; {new Date().getFullYear()} dig1tal. All rights reserved. Registered in England &amp; Wales.
        </p>
        <div class="flex items-center gap-4">
          <img src="/badges/gdpr-compliant.svg" alt="GDPR Compliant" class="h-8" loading="lazy" />
          <img src="/badges/cyber-essentials.svg" alt="Cyber Essentials" class="h-8" loading="lazy" />
          <img src="/badges/ico-registered.svg" alt="ICO Registered" class="h-8" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</footer>
